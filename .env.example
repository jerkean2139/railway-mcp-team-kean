# ---- Railway Guardrail MCP configuration -----------------------------------
# Copy to .env for local development. In production set these as Railway
# service variables. Never commit a real .env.

# Port the server listens on. Railway sets PORT automatically.
PORT=3000

# Railway Public API endpoint (override only if Railway changes it).
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2

# A single Railway TEAM / WORKSPACE token (the server's service identity).
# Create it at https://railway.com/account/tokens (scope it to the workspace).
RAILWAY_TOKEN=replace_me

# Postgres connection string. Railway's Postgres plugin provides DATABASE_URL.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Gateway bearer tokens mapped to human identities. This is the connect allowlist.
# Generate one strong random token per person. Example value below.
GATEWAY_TOKENS={"gw_live_REPLACE_WITH_RANDOM":"jeremy"}

# Who may approve gated (destructive) actions. Comma separated. MVP is just jeremy.
# Add Taha later with: APPROVERS=jeremy,taha
APPROVERS=jeremy

# How long a gated tool waits for a Slack decision before aborting (ms). 5 min.
APPROVAL_TIMEOUT_MS=300000

# ---- Slack ------------------------------------------------------------------
# Bot token (starts with xoxb-) from your Slack app's OAuth settings.
SLACK_BOT_TOKEN=xoxb-replace_me

# Signing secret from the Slack app's Basic Information page.
SLACK_SIGNING_SECRET=replace_me

# Channel id (looks like C0123ABCD) where approval requests are posted.
SLACK_APPROVAL_CHANNEL=C0123ABCD

# Slack user ids mapped to approver identities. Find a user id in their Slack
# profile (More -> Copy member ID). Must match a name in APPROVERS.
SLACK_APPROVER_IDS={"U0123ABCD":"jeremy"}

# Public HTTPS URL of this server (no trailing slash). Used in the OAuth
# discovery metadata so claude.ai chat / Projects / Cowork can connect. Set this
# to your Railway domain in production. If unset, it is derived from request
# headers, which also works on Railway.
PUBLIC_URL=https://your-app.up.railway.app
